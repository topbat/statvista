  "meta": {
    "version": "1.0.0",
    "date": "2026-11-09",
    "task": "T02 指标字典（种子冻结版）",
    "source": "01-PRD.md §2.2 + 设计方案 §2 领域模型 / §3.3 同环比",
    "count": 16,
    "themes": ["macro", "tech"],
    "polarity_defs": {
      "positive": "正指标：数值越高越好（红涨绿跌，▲#D32029 / ▼#08979C，箭头+数值同显）",
      "negative": "逆指标：数值越高越差（警示语义：文案“较上年上升 X pct”，D5 载体）"
    },
    "type_defs": {
      "atomic": "原子指标：事实字段+聚合，值直接入库",
      "derived": "派生指标：原子指标+时间修饰（本年累计），入库即为累计口径",
      "composite": "复合指标：多原子（含跨期基值）四则运算，由语义层现算，不落结果值"
    },
    "agg_type_defs": {
      "sum": "可加型：任意维度上卷直接求和",
      "ratio": "比值型：上卷=Σ分子/Σ分母，禁止对结果值直接求和",
      "cumulative": "累计型：本年1月至当月累计，环比无业务意义（compare_ops 仅 yoy）",
      "snapshot": "快照型：期末时点存量，跨区域可加、时间维度不可加"
    },
    "compare_policy_defs": {
      "window_sum": "窗口直接比较：按查询窗口聚合出当期值与对比期值后直接相减/求变化率；yoy 与 mom 均开放（可加型）",
      "compare_then_compute": "先比子项再算比值：分别取分子、分母的当期与对比期值再重算比值，差值以百分点表达（比值型，D3 载体）",
      "none": "无通用窗口比较：禁用环比（compare_ops 仅 yoy）；同比按 agg_type 固定口径直算——cumulative=本年累计对上年同期累计直接比，snapshot=期末值对上年同期期末值直接比（D4 载体）"
    },
    "compare_ops_defs": {
      "yoy": "同比（对比上年同期）",
      "mom": "环比（对比上月）；cumulative/snapshot 指标的 mom 请求被语义层拒绝（4xx）"
    },
    "formula_convention": {
      "num/den": "分子/分母引用的指标编码（ratio/composite 必填）",
      "@py": "上年同期基值（事实表 *_py 列，或时间平移 -12 月）",
      "ytd(x)": "x 的本年 1 月至当月累计窗口和"
    },
    "coverage_matrix": {
      "agg_type": { "sum": 7, "ratio": 5, "cumulative": 3, "snapshot": 1 },
      "compare_policy": { "window_sum": 7, "compare_then_compute": 5, "none": 4 },
      "polarity": { "positive": 15, "negative": 1 },
      "type": { "atomic": 8, "derived": 3, "composite": 5 },
      "note": "PRD §2.2 末行“sum 6/ratio 6”与其明细表不一致，以明细表逐行为准（sum7/ratio5/cu3/sn1）；比较策略按本表三值映射：直接比较→window_sum，禁环比仅同比/快照同比→none"
    }
  },
